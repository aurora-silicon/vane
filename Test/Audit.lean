import Lean

/-!
# vane-audit: proof and axiom audit

Loads the compiled `Vane` and `Vane.Proofs` modules from `LEAN_PATH` (no
re-elaboration) and checks, for every constant defined in a `Vane.*` module:

* no `axiom` declarations exist;
* no constant is marked `unsafe`, `@[implemented_by]`, or `@[extern]`;
* every theorem depends only on the standard axioms `propext`,
  `Classical.choice` and `Quot.sound` (so no `sorryAx`, `Lean.ofReduceBool`,
  `Lean.trustCompiler` or custom axioms);
* every other constant (definitions, opaques, inductives) obeys the same rule.

The audit fails closed: it requires `Vane.Proofs` to be loaded and at least
`minProofTheorems` user-declared theorems to be checked in it.
-/

open Lean

namespace Vane.Audit

/-- Axioms a kernel-clean Vane constant may depend on. -/
def standardAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- Lower bound on user-declared theorems in `Vane.Proofs`; guards against an
empty or truncated audit passing silently. -/
def minProofTheorems : Nat := 145

def proofsModule : Name := `Vane.Proofs

def isVaneModule (m : Name) : Bool :=
  m == `Vane || (`Vane).isPrefixOf m

/-- A theorem written in the source, as opposed to one generated by the
elaborator (equation lemmas, auxiliary `_proof_` lemmas, and so on). -/
def isUserTheorem (n : Name) : CoreM Bool := do
  if (privateToUserName n).isInternal then return false
  return (← findDeclarationRanges? n).isSome

structure Report where
  proofsTheorems : Nat := 0
  vaneTheorems : Nat := 0
  constants : Nat := 0
  errors : Array String := #[]

def audit : CoreM Report := do
  let env ← getEnv
  let modules := env.header.moduleNames
  unless modules.contains proofsModule do
    throwError "{proofsModule} is not among the loaded modules"
  let mut decls : Array (Name × Name × ConstantInfo) := #[]
  for (n, ci) in env.constants.map₁.toList do
    let some idx := env.getModuleIdxFor? n | continue
    let some m := modules[idx.toNat]? | continue
    if isVaneModule m then
      decls := decls.push (m, n, ci)
  decls := decls.qsort fun a b => Name.lt a.2.1 b.2.1
  let mut r : Report := {}
  for (m, n, ci) in decls do
    r := { r with constants := r.constants + 1 }
    if let .axiomInfo _ := ci then
      r := { r with errors := r.errors.push s!"custom axiom {n} declared in {m}" }
    if ci.isUnsafe then
      r := { r with errors := r.errors.push s!"unsafe constant {n} declared in {m}" }
    if let some impl := Lean.Compiler.implementedByAttr.getParam? env n then
      r := { r with errors := r.errors.push s!"implemented_by attribute on {n} ({m}) -> {impl}" }
    if Lean.isExtern env n then
      r := { r with errors := r.errors.push s!"extern attribute on {n} ({m})" }
    let axs ← collectAxioms n
    let bad := axs.filter fun a => !standardAxioms.contains a
    unless bad.isEmpty do
      r := { r with errors := r.errors.push s!"{n} ({m}) depends on non-standard axioms {bad.toList}" }
    if let .thmInfo _ := ci then
      if ← isUserTheorem n then
        r := { r with vaneTheorems := r.vaneTheorems + 1 }
        if m == proofsModule then
          r := { r with proofsTheorems := r.proofsTheorems + 1 }
  if r.proofsTheorems < minProofTheorems then
    let msg := s!"only {r.proofsTheorems} theorems found in {proofsModule}; expected at least {minProofTheorems}"
    r := { r with errors := r.errors.push msg }
  return r

end Vane.Audit

def main : IO UInt32 := do
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `Vane }, { module := `Vane.Proofs }] {}
  let (r, _) ← (Vane.Audit.audit).toIO
    { fileName := "<vane-audit>", fileMap := default } { env }
  for e in r.errors do
    IO.eprintln s!"[FAIL] proof-audit: {e}"
  if r.errors.isEmpty then
    IO.println s!"[PASS] proof-audit: {r.proofsTheorems} theorems in Vane.Proofs ({r.vaneTheorems} total across Vane.*) verified kernel-clean"
    IO.println s!"       {r.constants} Vane.* constants checked (no custom axioms, unsafe, implemented_by, or extern); allowed axioms: {Vane.Audit.standardAxioms}"
    return 0
  else
    IO.eprintln s!"[FAIL] proof-audit: {r.errors.size} problem(s) across {r.constants} Vane.* constants"
    return 1
